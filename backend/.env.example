# BRIGHTS — environment configuration example. Copy to backend/.env and fill in.

# EODHD API key — https://eodhd.com
# Free plan = EOD prices only (no fundamentals/shareholders, ~1y history, 20 req/day).
# A paid "Fundamentals" plan is required for financial statements & ownership via EODHD.
EODHD_API_KEY=

# Sectors.app (Supertype) API key — https://sectors.app
# Licensed IDX/KSEI fundamentals & shareholder data (recommended primary source).
SECTORS_API_KEY=

# Comma-separated source precedence. Default: sectors,eodhd
DATA_SOURCE_PRIORITY=sectors,eodhd

# KSEI SID statistics — MUST be a JSON endpoint returning e.g.
# {"total_sid": 14200000, "equity_sid": 6100000, "as_of_date": "2026-07-31"}
KSEI_STATISTICS_URL=
